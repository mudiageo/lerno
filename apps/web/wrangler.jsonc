{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lerno",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "upload_source_maps": true
}
